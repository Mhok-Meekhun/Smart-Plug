# Deferred paid Render service. Copy this service entry into the root
# render.yaml only after approving the current Render Starter price and
# provisioning production MQTT credentials.
services:
  - type: worker
    name: smart-home-iot-worker
    runtime: node
    region: singapore
    plan: starter
    autoDeployTrigger: checksPass
    maxShutdownDelaySeconds: 30
    buildCommand: corepack enable && corepack prepare pnpm@10.15.1 --activate && pnpm install --frozen-lockfile && pnpm --filter @smart-home/iot-worker build
    startCommand: pnpm --filter @smart-home/iot-worker start
    envVars:
      - key: NODE_VERSION
        value: 24.18.0
      - key: NODE_ENV
        value: production
      - key: DATABASE_URL
        sync: false
      - key: SUPABASE_URL
        value: https://xxzhkgpyfchvcwvrjzer.supabase.co
      - key: SUPABASE_SECRET_KEY
        sync: false
      - key: MQTT_URL
        sync: false
      - key: MQTT_USERNAME
        sync: false
      - key: MQTT_PASSWORD
        sync: false
      - key: MQTT_CLIENT_ID
        value: smart-home-worker-production
      - key: OUTBOX_POLL_MS
        value: "500"
